# FIO Job: sequential_write
# Sequential write - writeback/flush characterization
# Generated: 2026-02-12T03:40:37.707597

[global]
filename=/tmp/fio_testfile
size=1G
runtime=30
time_based
group_reporting
log_avg_msec=1000
write_bw_log=sequential_write
write_lat_log=sequential_write
write_iops_log=sequential_write

[sequential_write]
ioengine=libaio
rw=write
bs=128k
iodepth=32
direct=1
numjobs=1
